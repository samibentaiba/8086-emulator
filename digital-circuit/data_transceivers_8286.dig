<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes>
    <entry><string>Description</string><string>Intel 8286 / 74LS245 16-Bit Bidirectional Bus Transceiver</string></entry>
    <entry><string>Width</string><int>5</int></entry>
  </attributes>
  <visualElements>
    <!-- Inputs in exact order -->
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>CPU_IN</string></entry>
        <entry><string>Bits</string><int>16</int></entry>
      </elementAttributes>
      <pos x="100" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>SYS_IN</string></entry>
        <entry><string>Bits</string><int>16</int></entry>
      </elementAttributes>
      <pos x="100" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes><entry><string>Label</string><string>DT_R</string></entry></elementAttributes>
      <pos x="100" y="180"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes><entry><string>Label</string><string>DEN_N</string></entry></elementAttributes>
      <pos x="100" y="220"/>
    </visualElement>

    <!-- Outputs in exact order -->
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>CPU_OUT</string></entry>
        <entry><string>Bits</string><int>16</int></entry>
      </elementAttributes>
      <pos x="600" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>SYS_OUT</string></entry>
        <entry><string>Bits</string><int>16</int></entry>
      </elementAttributes>
      <pos x="600" y="140"/>
    </visualElement>

    <!-- Transceiver Control Logic -->
    <!-- Invert DEN_N: enabled when low -->
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="160" y="220"/>
    </visualElement>

    <!-- Invert DT_R for receive mode (SYS -> CPU) -->
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="160" y="180"/>
    </visualElement>

    <!-- AND for en_rx (Receive: DEN_N=0 and DT_R=0) -->
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="240" y="180"/>
    </visualElement>

    <!-- AND for en_tx (Transmit: DEN_N=0 and DT_R=1) -->
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="240" y="260"/>
    </visualElement>

    <!-- CPU_OUT Mux (Receive): SYS_IN if en_rx else 0 -->
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><int>0</int></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes>
      <pos x="360" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes><entry><string>Bits</string><int>16</int></entry></elementAttributes>
      <pos x="380" y="100"/>
    </visualElement>

    <!-- SYS_OUT Mux (Transmit): CPU_IN if en_tx else 0 -->
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><int>0</int></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes>
      <pos x="360" y="240"/>
    </visualElement>
    <visualElement>
      <elementName>Multiplexer</elementName>
      <elementAttributes><entry><string>Bits</string><int>16</int></entry></elementAttributes>
      <pos x="380" y="240"/>
    </visualElement>

    <!-- Verification Testcase -->
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>
CPU_IN SYS_IN DT_R DEN_N CPU_OUT SYS_OUT
# Disabled (DEN_N=1)
0x1234 0x5678 1    1     0       0
0x1234 0x5678 0    1     0       0
# Transmit (DEN_N=0, DT_R=1): CPU_IN -> SYS_OUT
0x1234 0x0000 1    0     0       0x1234
# Receive (DEN_N=0, DT_R=0): SYS_IN -> CPU_OUT
0x0000 0x5678 0    0     0x5678  0
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="480" y="320"/>
    </visualElement>
  </visualElements>
  <wires>
    <!-- DEN_N invert: (100, 220) -> (160, 220), out at (200, 220) -->
    <wire><p1 x="100" y="220"/><p2 x="160" y="220"/></wire>
    <wire><p1 x="200" y="220"/><p2 x="220" y="220"/></wire>
    <wire><p1 x="220" y="220"/><p2 x="240" y="220"/></wire>
    <wire><p1 x="220" y="220"/><p2 x="220" y="300"/></wire>
    <wire><p1 x="220" y="300"/><p2 x="240" y="300"/></wire>

    <!-- DT_R distribution: (100, 180) to Not(160, 180) and And_tx(240, 260) -->
    <wire><p1 x="100" y="180"/><p2 x="130" y="180"/></wire>
    <wire><p1 x="130" y="180"/><p2 x="160" y="180"/></wire>
    <wire><p1 x="130" y="180"/><p2 x="130" y="260"/></wire>
    <wire><p1 x="130" y="260"/><p2 x="240" y="260"/></wire>

    <!-- Not DT_R to And_rx(240, 180) -->
    <wire><p1 x="200" y="180"/><p2 x="240" y="180"/></wire>

    <!-- en_rx out at (300, 200) to Mux1 sel at (400, 140) -->
    <wire><p1 x="300" y="200"/><p2 x="400" y="200"/></wire>
    <wire><p1 x="400" y="200"/><p2 x="400" y="140"/></wire>

    <!-- en_tx out at (300, 280) to Mux2 sel at (400, 280) -->
    <wire><p1 x="300" y="280"/><p2 x="400" y="280"/></wire>

    <!-- Mux 1 (CPU_OUT): in_0(380, 100), in_1(380, 140), out(420, 120) -->
    <wire><p1 x="360" y="100"/><p2 x="380" y="100"/></wire>
    <wire><p1 x="100" y="140"/><p2 x="380" y="140"/></wire>
    <wire><p1 x="420" y="120"/><p2 x="560" y="120"/></wire>
    <wire><p1 x="560" y="120"/><p2 x="560" y="100"/></wire>
    <wire><p1 x="560" y="100"/><p2 x="600" y="100"/></wire>

    <!-- Mux 2 (SYS_OUT): in_0(380, 240), in_1(380, 280), out(420, 260) -->
    <wire><p1 x="360" y="240"/><p2 x="380" y="240"/></wire>
    <!-- CPU_IN(100, 100) to Mux2 in_1(380, 280) -->
    <wire><p1 x="100" y="100"/><p2 x="110" y="100"/></wire>
    <wire><p1 x="110" y="100"/><p2 x="110" y="320"/></wire>
    <wire><p1 x="110" y="320"/><p2 x="350" y="320"/></wire>
    <wire><p1 x="350" y="320"/><p2 x="350" y="280"/></wire>
    <wire><p1 x="350" y="280"/><p2 x="380" y="280"/></wire>
    <wire><p1 x="420" y="260"/><p2 x="580" y="260"/></wire>
    <wire><p1 x="580" y="260"/><p2 x="580" y="140"/></wire>
    <wire><p1 x="580" y="140"/><p2 x="600" y="140"/></wire>
  </wires>
</circuit>
