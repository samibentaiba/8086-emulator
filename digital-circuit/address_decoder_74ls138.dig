<?xml version="1.0" encoding="utf-8"?>
<circuit>
  <version>1</version>
  <attributes>
    <entry><string>Description</string><string>74LS138 3-to-8 Address Decoder for 8086 Memory &amp; I/O Space</string></entry>
    <entry><string>Width</string><int>6</int></entry>
  </attributes>
  <visualElements>
    <!-- Inputs in exact order -->
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>A19_16</string></entry>
        <entry><string>Bits</string><int>4</int></entry>
      </elementAttributes>
      <pos x="100" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>In</elementName>
      <elementAttributes><entry><string>Label</string><string>M_IO_N</string></entry></elementAttributes>
      <pos x="100" y="140"/>
    </visualElement>

    <!-- Outputs in exact order -->
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes><entry><string>Label</string><string>CS_RAM0_N</string></entry></elementAttributes>
      <pos x="600" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes><entry><string>Label</string><string>CS_RAM1_N</string></entry></elementAttributes>
      <pos x="600" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes><entry><string>Label</string><string>CS_VIDEO_N</string></entry></elementAttributes>
      <pos x="600" y="180"/>
    </visualElement>
    <visualElement>
      <elementName>Out</elementName>
      <elementAttributes><entry><string>Label</string><string>CS_ROM_N</string></entry></elementAttributes>
      <pos x="600" y="220"/>
    </visualElement>

    <!-- Tunnels for inputs -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>A_bus</string></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="100" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>M_IO</string></entry></elementAttributes>
      <pos x="100" y="140"/>
    </visualElement>

    <!-- 1. CS_RAM0_N: A19_16 == 0 and M_IO -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>A_bus</string></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><int>0</int></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="120"/>
    </visualElement>
    <visualElement>
      <elementName>Comparator</elementName>
      <elementAttributes><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="180" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>M_IO</string></entry></elementAttributes>
      <pos x="260" y="80"/>
    </visualElement>
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="280" y="80"/>
    </visualElement>
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="380" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_RAM0</string></entry></elementAttributes>
      <pos x="440" y="100"/>
    </visualElement>

    <!-- 2. CS_RAM1_N: A19_16 < 8 and ~RAM0 (CS_RAM0) and M_IO -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>A_bus</string></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="200"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><int>8</int></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="220"/>
    </visualElement>
    <visualElement>
      <elementName>Comparator</elementName>
      <elementAttributes><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="180" y="200"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>M_IO</string></entry></elementAttributes>
      <pos x="260" y="200"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_RAM0</string></entry></elementAttributes>
      <pos x="260" y="220"/>
    </visualElement>
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes><entry><string>Inputs</string><int>3</int></entry></elementAttributes>
      <pos x="280" y="200"/>
    </visualElement>
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="380" y="220"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_RAM1</string></entry></elementAttributes>
      <pos x="440" y="220"/>
    </visualElement>

    <!-- 3. CS_VIDEO_N: A19_16 == 11 and M_IO -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>A_bus</string></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="300"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><int>11</int></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="320"/>
    </visualElement>
    <visualElement>
      <elementName>Comparator</elementName>
      <elementAttributes><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="180" y="300"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>M_IO</string></entry></elementAttributes>
      <pos x="260" y="300"/>
    </visualElement>
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="280" y="300"/>
    </visualElement>
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="380" y="320"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_VIDEO</string></entry></elementAttributes>
      <pos x="440" y="320"/>
    </visualElement>

    <!-- 4. CS_ROM_N: A19_16 == 15 and M_IO -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>A_bus</string></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="400"/>
    </visualElement>
    <visualElement>
      <elementName>Const</elementName>
      <elementAttributes><entry><string>Value</string><int>15</int></entry><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="160" y="420"/>
    </visualElement>
    <visualElement>
      <elementName>Comparator</elementName>
      <elementAttributes><entry><string>Bits</string><int>4</int></entry></elementAttributes>
      <pos x="180" y="400"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>M_IO</string></entry></elementAttributes>
      <pos x="260" y="400"/>
    </visualElement>
    <visualElement>
      <elementName>And</elementName>
      <elementAttributes/>
      <pos x="280" y="400"/>
    </visualElement>
    <visualElement>
      <elementName>Not</elementName>
      <elementAttributes/>
      <pos x="380" y="420"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_ROM</string></entry></elementAttributes>
      <pos x="440" y="420"/>
    </visualElement>

    <!-- Output Tunnels -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_RAM0</string></entry></elementAttributes>
      <pos x="580" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_RAM1</string></entry></elementAttributes>
      <pos x="580" y="140"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_VIDEO</string></entry></elementAttributes>
      <pos x="580" y="180"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>CS_ROM</string></entry></elementAttributes>
      <pos x="580" y="220"/>
    </visualElement>

    <!-- Testcase -->
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>
A19_16 M_IO_N CS_RAM0_N CS_RAM1_N CS_VIDEO_N CS_ROM_N
0      1      0         1         1          1
2      1      1         0         1          1
11     1      1         1         0          1
15     1      1         1         1          0
0      0      1         1         1          1
</dataString>
          </testData>
        </entry>
      </elementAttributes>
      <pos x="500" y="300"/>
    </visualElement>
  </visualElements>
  <wires>
    <!-- 1. RAM0: Comp(180, 100) -> = is (240, 120). And(280, 80) -> In_1(280, 80), In_2(280, 120), out(340, 100) -->
    <wire><p1 x="160" y="100"/><p2 x="180" y="100"/></wire>
    <wire><p1 x="160" y="120"/><p2 x="180" y="120"/></wire>
    <wire><p1 x="260" y="80"/><p2 x="280" y="80"/></wire>
    <wire><p1 x="240" y="120"/><p2 x="280" y="120"/></wire>
    <wire><p1 x="340" y="100"/><p2 x="380" y="100"/></wire>
    <wire><p1 x="420" y="100"/><p2 x="440" y="100"/></wire>

    <!-- 2. RAM1: Comp(180, 200) -> < is (240, 240). And(280, 200) -> In_1(280, 200), In_2(280, 220), In_3(280, 240), out(340, 220) -->
    <wire><p1 x="160" y="200"/><p2 x="180" y="200"/></wire>
    <wire><p1 x="160" y="220"/><p2 x="180" y="220"/></wire>
    <wire><p1 x="260" y="200"/><p2 x="280" y="200"/></wire>
    <wire><p1 x="260" y="220"/><p2 x="280" y="220"/></wire>
    <wire><p1 x="240" y="240"/><p2 x="280" y="240"/></wire>
    <wire><p1 x="340" y="220"/><p2 x="380" y="220"/></wire>
    <wire><p1 x="420" y="220"/><p2 x="440" y="220"/></wire>

    <!-- 3. Video: Comp(180, 300) -> = is (240, 320). And(280, 300) -> In_1(280, 300), In_2(280, 340), out(340, 320) -->
    <wire><p1 x="160" y="300"/><p2 x="180" y="300"/></wire>
    <wire><p1 x="160" y="320"/><p2 x="180" y="320"/></wire>
    <wire><p1 x="260" y="300"/><p2 x="280" y="300"/></wire>
    <wire><p1 x="240" y="320"/><p2 x="260" y="320"/></wire>
    <wire><p1 x="260" y="320"/><p2 x="260" y="340"/></wire>
    <wire><p1 x="260" y="340"/><p2 x="280" y="340"/></wire>
    <wire><p1 x="340" y="320"/><p2 x="380" y="320"/></wire>
    <wire><p1 x="420" y="320"/><p2 x="440" y="320"/></wire>

    <!-- 4. ROM: Comp(180, 400) -> = is (240, 420). And(280, 400) -> In_1(280, 400), In_2(280, 440), out(340, 420) -->
    <wire><p1 x="160" y="400"/><p2 x="180" y="400"/></wire>
    <wire><p1 x="160" y="420"/><p2 x="180" y="420"/></wire>
    <wire><p1 x="260" y="400"/><p2 x="280" y="400"/></wire>
    <wire><p1 x="240" y="420"/><p2 x="260" y="420"/></wire>
    <wire><p1 x="260" y="420"/><p2 x="260" y="440"/></wire>
    <wire><p1 x="260" y="440"/><p2 x="280" y="440"/></wire>
    <wire><p1 x="340" y="420"/><p2 x="380" y="420"/></wire>
    <wire><p1 x="420" y="420"/><p2 x="440" y="420"/></wire>

    <!-- Outputs -->
    <wire><p1 x="580" y="100"/><p2 x="600" y="100"/></wire>
    <wire><p1 x="580" y="140"/><p2 x="600" y="140"/></wire>
    <wire><p1 x="580" y="180"/><p2 x="600" y="180"/></wire>
    <wire><p1 x="580" y="220"/><p2 x="600" y="220"/></wire>
  </wires>
</circuit>
