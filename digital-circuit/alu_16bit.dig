      <elementAttributes><entry><string>NetName</string><string>AF_net</string></entry></elementAttributes>
      <pos x="880" y="340"/>
    </visualElement>

    <!-- Testcase -->
    <visualElement>
      <elementName>Testcase</elementName>
      <elementAttributes>
        <entry>
          <string>Testdata</string>
          <testData>
            <dataString>
A      B      Cin Op Y      CF ZF SF OF PF AF
# ADD: 0x1234 + 0x0001 = 0x1235 (low byte 0x35 has 4 bits -> PF=1)
0x1234 0x0001 0   0  0x1235 0  0  0  0  1  0
# ADD with carry: 0xFFFF + 0x0001 = 0x0000 (CF=1, ZF=1, PF=1)
0xFFFF 0x0001 0   0  0x0000 1  1  0  0  1  1
# ADD overflow: 0x7FFF + 0x0001 = 0x8000 (OF=1, SF=1, PF=1)
0x7FFF 0x0001 0   0  0x8000 0  0  1  1  1  1
# SUB: 0x1000 - 0x0001 = 0x0FFF (low byte 0xFF has 8 bits -> PF=1, AF=0)
0x1000 0x0001 0   1  0x0FFF 0  0  0  0  1  0
# SUB with borrow: 0x0000 - 0x0001 = 0xFFFF (CF=1, borrow, PF=1, AF=0)
0x0000 0x0001 0   1  0xFFFF 1  0  1  0  1  0
# AND: 0xAAAA &amp; 0x5555 = 0x0000 (ZF=1, PF=1)
0xAAAA 0x5555 0   2  0x0000 0  1  0  0  1  0
# OR: 0xAAAA | 0x5555 = 0xFFFF
0xAAAA 0x5555 0   3  0xFFFF 0  0  1  0  1  0
# XOR: 0x1234 ^ 0x1234 = 0x0000 (ZF=1, PF=1)
0x1234 0x1234 0   4  0x0000 0  1  0  0  1  0
</dataString>
          </testData>
        </entry>
