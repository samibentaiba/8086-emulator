      <elementName>Out</elementName>
      <elementAttributes>
        <entry><string>Label</string><string>AF</string></entry>
      </elementAttributes>
      <pos x="900" y="340"/>
    </visualElement>

    <!-- Input tunnels -->
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>A_bus</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes>
      <pos x="100" y="100"/>
    </visualElement>
    <visualElement>
      <elementName>Tunnel</elementName>
      <elementAttributes><entry><string>NetName</string><string>B_bus</string></entry><entry><string>Bits</string><int>16</int></entry></elementAttributes>
